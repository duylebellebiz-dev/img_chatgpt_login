# Postgres — create the DB/role first (see README), then fill this in.
DATABASE_URL=

# Claude still uses its API key for prompt building and quality scoring.
# Images default to the locally authenticated Antigravity CLI (Gemini OAuth,
# "agy") but every batch/edit request can override this to "gpt" (OpenAI
# Images API) individually — this is just the deployment-wide fallback. Set
# IMAGE_PROVIDER=mock for deterministic offline placeholders.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
IMAGE_PROVIDER=agy
AGY_BIN=
AGY_IMAGE_MODEL=nano-banana-2
# Orchestrator model the Antigravity CLI runs as when calling the image tool.
# Run `agy models` to see the current list (e.g. gemini-3.1-pro-high,
# gemini-3.6-flash-high, claude-opus-4-6-thinking).
AGY_MODEL=gemini-3.1-pro-high
AGY_GENERATION_TIMEOUT_SECONDS=400

# ChatGPT image generation — the "gpt" provider option. Goes through
# ima2-gen's local OAuth server (../ima2-gen), which uses the signed-in
# ChatGPT account's plan quota (via `codex login`) instead of a billed API
# key — like AGY above, but for ChatGPT. Requires `ima2 serve` running
# alongside this backend (default port 3333); see ima2-gen/README.md.
IMA2_SERVER_URL=http://localhost:3333
GPT_OAUTH_MODEL=gpt-5.4-mini
GPT_OAUTH_QUALITY=low
GPT_OAUTH_GENERATION_TIMEOUT_SECONDS=180

# Google Gemini API (billed) — the "gemini_api" provider option. Calls
# generativelanguage.googleapis.com directly with a real API key instead of
# the free Antigravity CLI OAuth ("agy"). Get a key at
# aistudio.google.com/apikey. Leave GEMINI_API_KEY blank to hide/disable
# this provider; it still supports the same 1-100 image batch as every
# other provider.
GEMINI_API_KEY=
GEMINI_API_MODEL=nano-banana-2
GEMINI_API_TIMEOUT_SECONDS=120
GEMINI_API_PRICE_PER_IMAGE_USD=0

# Google Gemini Batch API (billed, "gemini_batch_api" provider) — same key
# and model as GEMINI_API_KEY/GEMINI_API_MODEL above, but calls
# batchGenerateContent instead of generateContent: ~50% cheaper per
# Google's Batch Mode pricing, in exchange for not returning an image
# instantly (each image is submitted as its own batch job and polled until
# it finishes). Google's own target turnaround is up to 24h, usually much
# quicker — raise the timeout if your batches are consistently slower.
GEMINI_BATCH_API_POLL_INTERVAL_SECONDS=10
GEMINI_BATCH_API_TIMEOUT_SECONDS=900
GEMINI_BATCH_API_PRICE_PER_IMAGE_USD=0


STORAGE_ROOT=./storage

# Cloudinary — durable copy of storage_root. Leave all blank to run
# local-disk-only (fine for local dev). Required for a real deploy on a host
# without a persistent disk (e.g. Render free web service), since local
# storage_root can be wiped on restart/scale-to-zero there. Get these from
# the Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Module 3 — Image Quality Agent
QUALITY_PASS_THRESHOLD=80
QUALITY_MAX_RETRIES=0
NEAR_DUPLICATE_MAX_RETRIES=2
QUALITY_HARD_FAILURE_THRESHOLD=30
# Per-provider overrides for the two retry budgets above (batch generator
# only) — ChatGPT retries more since a miss is usually just a bad roll on
# its free OAuth quota; the billed Gemini API key only auto-retries the
# near-duplicate case (provider returned a reference image back unchanged),
# not an ordinary low score.
GPT_QUALITY_MAX_RETRIES=3
GPT_NEAR_DUPLICATE_MAX_RETRIES=3
GEMINI_API_QUALITY_MAX_RETRIES=0
GEMINI_API_NEAR_DUPLICATE_MAX_RETRIES=1

# Module 1 — Batch Image Generator
BATCH_MIN_IMAGES=1
BATCH_MAX_IMAGES=100
# A BatchJob still "processing" when the backend starts is resumed
# automatically (picks up from images already saved, and reconnects to any
# in-flight Gemini Batch API job instead of losing/re-billing it) — see
# batch_tasks.resume_orphaned_batch_jobs. Set to false to disable.
RESUME_ORPHANED_BATCH_JOBS_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Facebook/Instagram auto-posting (Meta Graph API). Leave FACEBOOK_APP_ID/
# SECRET blank to run in mock mode (simulated connect/publish, no real Meta
# App needed). Create a Meta App at developers.facebook.com to get real
# values; while the app is in Development mode, only accounts added as
# Admin/Developer/Tester on that app can connect. Going live for other
# salons requires Meta App Review + Business Verification, submitted by you
# in the Meta dashboard — not something this codebase can do for you.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social/connect/facebook/callback

# Fernet key encrypting stored Facebook/Instagram access tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Signs the httpOnly session cookie issued on register/login (each salon
# registers its own account — see app/routers/auth.py).
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# Hours before a scheduled post's target datetime that AI content
# (caption/hashtags) is generated and queued for review.
CONTENT_LEAD_TIME_HOURS=24

# This backend's own public URL (e.g. https://your-app.onrender.com) — Meta
# Graph API needs to fetch the generated image over the internet when
# publishing for real. Not needed in mock mode or local-only development.
PUBLIC_BASE_URL=

# Optional: any endpoint that accepts a JSON POST (Slack/Discord incoming
# webhook, Zapier/Make catch hook). Every Notification is also delivered here
# so you don't have to keep the app open. Leave blank for in-app only.
NOTIFICATION_WEBHOOK_URL=

# Auto-refill: opt in per campaign (see campaign settings in the app). If a
# campaign has fewer than AUTO_REFILL_MIN_BUFFER_POSTS upcoming posts within
# AUTO_REFILL_BUFFER_DAYS, a new batch is auto-generated by cloning its last
# completed batch's design/pose images (capped by AUTO_REFILL_COOLDOWN_HOURS
# between refills per campaign, to bound cost).
AUTO_REFILL_BUFFER_DAYS=7
AUTO_REFILL_MIN_BUFFER_POSTS=3
AUTO_REFILL_COOLDOWN_HOURS=24
